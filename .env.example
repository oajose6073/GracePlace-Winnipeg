# Copy to `.env` (gitignored) for local development. In production these are
# set in Netlify: Site configuration > Environment variables.
#
# Anything prefixed with VITE_ is compiled into the public JavaScript bundle.
# Only put values here that are safe for visitors to see.

# "Latest Sermons" on the home page. Restrict the key by HTTP referrer
# (graceplacewpg.ca/*) in Google Cloud Console. Without these the section
# links to the YouTube channel instead.
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=

# Ask a Question page (Supabase table series_questions). Use the publishable
# key (sb_publishable_...), never the secret key. Without these, submitting a
# question shows an error with the church email as a fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. A form backend that accepts a JSON POST (Formspree, Basin,
# Web3Forms). Leave empty and the contact and ride forms open a pre-filled
# email to the church instead.
VITE_FORM_ENDPOINT=
